program Kepemilikan

tipe Catatan {
    data: kotak<i64>
    label: i32
}

fungsi jumlahkan(k: kotak<i64>, tambahan: i64) -> kotak<i64> {
    nilai total = isi(k) + tambahan
    kembalikan kotak(total)
}

fungsi baca_catatan(c: Catatan) -> i64 {
    kembalikan isi(c.data)
}

utama {
    nilai a = kotak(100)
    nilai b = jumlahkan(a, 50)
    tampilkan(isi(b))

    nilai c = Catatan { data: kotak(7), label: 1i32 }
    tampilkan(baca_catatan(c))

    ubah total = 0
    untuk i dari 1 hingga 5 {
        nilai sementara = kotak(i)
        total = total + isi(sementara)
    }
    tampilkan(total)
}
