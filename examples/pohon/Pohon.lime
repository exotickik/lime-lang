modul Pohon

enum Jenis {
    Angka,
    Tambah,
    Kurang,
    Kali,
    Bagi,
    KurungBuka,
    KurungTutup,
}

tipe Token {
    jenis: Jenis
    muatan: angka
}

tipe Node {
    jenis: Jenis
    data: angka
    kiri: angka
    kanan: angka
}

tipe Langkah {
    pos: angka
    idx: angka
}

fungsi jenis_operator(b: angka) -> Jenis {
    jika b == 43 {
        kembalikan Jenis.Tambah
    }
    jika b == 45 {
        kembalikan Jenis.Kurang
    }
    jika b == 42 {
        kembalikan Jenis.Kali
    }
    jika b == 47 {
        kembalikan Jenis.Bagi
    }
    jika b == 40 {
        kembalikan Jenis.KurungBuka
    }
    kembalikan Jenis.KurungTutup
}

fungsi lex(sumber: teks) -> daftar<Token> {
    ubah keluar: daftar<Token> = daftar()
    nilai n = panjang(sumber)
    ubah i: angka = 0
    selama i < n {
        nilai b = bita_pada(sumber, i) sebagai angka
        jika b == 32 || b == 9 || b == 10 {
            i = i + 1
            lanjut
        }
        jika b >= 48 && b <= 57 {
            ubah v: angka = 0
            selama i < n && bita_pada(sumber, i) sebagai angka >= 48 && bita_pada(sumber, i) sebagai angka <= 57 {
                v = v * 10 + (bita_pada(sumber, i) sebagai angka - 48)
                i = i + 1
            }
            dorong(ambil_ubah(keluar), Token { jenis: Jenis.Angka, muatan: v })
            lanjut
        }
        dorong(ambil_ubah(keluar), Token { jenis: jenis_operator(b), muatan: 0 })
        i = i + 1
    }
    kembalikan keluar
}

fungsi tambah_node(arena: &ubah daftar<Node>, n: Node) -> angka {
    nilai idx = panjang(arena)
    dorong(arena, n)
    kembalikan idx
}

fungsi prec(j: Jenis) -> angka {
    cocok j {
        Tambah => {
            kembalikan 1
        }
        Kurang => {
            kembalikan 1
        }
        Kali => {
            kembalikan 2
        }
        Bagi => {
            kembalikan 2
        }
        lain => {
            kembalikan 0
        }
    }
    kembalikan 0
}

fungsi urai_primary(toks: &daftar<Token>, arena: &ubah daftar<Node>, pos: angka) -> Langkah {
    nilai tok = elemen(toks, pos)
    cocok tok.jenis {
        KurungBuka => {
            nilai dalam = urai_ekspresi(toks, arena, pos + 1, 1)
            kembalikan Langkah { pos: dalam.pos + 1, idx: dalam.idx }
        }
        lain => {
            nilai id = tambah_node(arena, Node { jenis: Jenis.Angka, data: tok.muatan, kiri: 0 - 1, kanan: 0 - 1 })
            kembalikan Langkah { pos: pos + 1, idx: id }
        }
    }
    kembalikan Langkah { pos: pos + 1, idx: 0 }
}

fungsi urai_ekspresi(toks: &daftar<Token>, arena: &ubah daftar<Node>, pos: angka, min_prec: angka) -> Langkah {
    nilai awal = urai_primary(toks, arena, pos)
    ubah kiri_idx: angka = awal.idx
    ubah p: angka = awal.pos
    nilai n = panjang(toks)
    selama p < n {
        nilai op = elemen(toks, p).jenis
        nilai pr = prec(op)
        jika pr < min_prec {
            berhenti
        }
        nilai kanan = urai_ekspresi(toks, arena, p + 1, pr + 1)
        nilai baru = tambah_node(arena, Node { jenis: op, data: 0, kiri: kiri_idx, kanan: kanan.idx })
        kiri_idx = baru
        p = kanan.pos
    }
    kembalikan Langkah { pos: p, idx: kiri_idx }
}

fungsi hitung(arena: &daftar<Node>, idx: angka) -> angka {
    nilai node = elemen(arena, idx)
    cocok node.jenis {
        Angka => {
            kembalikan node.data
        }
        Tambah => {
            kembalikan hitung(arena, node.kiri) + hitung(arena, node.kanan)
        }
        Kurang => {
            kembalikan hitung(arena, node.kiri) - hitung(arena, node.kanan)
        }
        Kali => {
            kembalikan hitung(arena, node.kiri) * hitung(arena, node.kanan)
        }
        Bagi => {
            kembalikan hitung(arena, node.kiri) / hitung(arena, node.kanan)
        }
        lain => {
            kembalikan 0
        }
    }
    kembalikan 0
}

publik fungsi evaluasi(sumber: teks) -> angka {
    nilai toks = lex(sumber)
    ubah arena: daftar<Node> = daftar()
    nilai akar = urai_ekspresi(ambil(toks), ambil_ubah(arena), 0, 1)
    kembalikan hitung(ambil(arena), akar.idx)
}
