modul Kalkulator

enum Jenis {
    Angka,
    Tambah,
    Kurang,
    Kali,
    Bagi,
    KurungBuka,
    KurungTutup,
}

tipe Token {
    jenis: Jenis
    muatan: angka
}

tipe Langkah {
    pos: angka
    hasil: angka
}

fungsi jenis_operator(b: angka) -> Jenis {
    jika b == 43 {
        kembalikan Jenis.Tambah
    }
    jika b == 45 {
        kembalikan Jenis.Kurang
    }
    jika b == 42 {
        kembalikan Jenis.Kali
    }
    jika b == 47 {
        kembalikan Jenis.Bagi
    }
    jika b == 40 {
        kembalikan Jenis.KurungBuka
    }
    kembalikan Jenis.KurungTutup
}

fungsi lex(sumber: teks) -> daftar<Token> {
    ubah keluar: daftar<Token> = daftar()
    nilai n = panjang(sumber)
    ubah i: angka = 0
    selama i < n {
        nilai b = bita_pada(sumber, i) sebagai angka
        jika b == 32 || b == 9 || b == 10 {
            i = i + 1
            lanjut
        }
        jika b >= 48 && b <= 57 {
            ubah v: angka = 0
            selama i < n && bita_pada(sumber, i) sebagai angka >= 48 && bita_pada(sumber, i) sebagai angka <= 57 {
                v = v * 10 + (bita_pada(sumber, i) sebagai angka - 48)
                i = i + 1
            }
            dorong(ambil_ubah(keluar), Token { jenis: Jenis.Angka, muatan: v })
            lanjut
        }
        dorong(ambil_ubah(keluar), Token { jenis: jenis_operator(b), muatan: 0 })
        i = i + 1
    }
    kembalikan keluar
}

fungsi prec(jenis: Jenis) -> angka {
    cocok jenis {
        Tambah => {
            kembalikan 1
        }
        Kurang => {
            kembalikan 1
        }
        Kali => {
            kembalikan 2
        }
        Bagi => {
            kembalikan 2
        }
        lain => {
            kembalikan 0
        }
    }
    kembalikan 0
}

fungsi terapkan(op: Jenis, a: angka, b: angka) -> angka {
    cocok op {
        Tambah => {
            kembalikan a + b
        }
        Kurang => {
            kembalikan a - b
        }
        Kali => {
            kembalikan a * b
        }
        lain => {
            kembalikan a / b
        }
    }
    kembalikan 0
}

fungsi primary(t: &daftar<Token>, pos: angka) -> Langkah {
    nilai tok = elemen(t, pos)
    cocok tok.jenis {
        KurungBuka => {
            nilai dalam = ekspresi(t, pos + 1, 1)
            kembalikan Langkah { pos: dalam.pos + 1, hasil: dalam.hasil }
        }
        lain => {
            kembalikan Langkah { pos: pos + 1, hasil: tok.muatan }
        }
    }
    kembalikan Langkah { pos: pos + 1, hasil: tok.muatan }
}

fungsi ekspresi(t: &daftar<Token>, pos: angka, min_prec: angka) -> Langkah {
    nilai awal = primary(t, pos)
    ubah kiri: angka = awal.hasil
    ubah p: angka = awal.pos
    nilai n = panjang(t)
    selama p < n {
        nilai op = elemen(t, p).jenis
        nilai pr = prec(op)
        jika pr < min_prec {
            berhenti
        }
        nilai kanan = ekspresi(t, p + 1, pr + 1)
        kiri = terapkan(op, kiri, kanan.hasil)
        p = kanan.pos
    }
    kembalikan Langkah { pos: p, hasil: kiri }
}

publik fungsi evaluasi(sumber: teks) -> angka {
    nilai toks = lex(sumber)
    nilai r = ekspresi(ambil(toks), 0, 1)
    kembalikan r.hasil
}
