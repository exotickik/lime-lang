    }
    jika cocok_kata(src, mulai, akhir, "ubah") {
        kembalikan 6
    }
    jika cocok_kata(src, mulai, akhir, "jika") {
        kembalikan 7
    }
    jika cocok_kata(src, mulai, akhir, "lain") {
        kembalikan 8
    }
    jika cocok_kata(src, mulai, akhir, "selama") {
        kembalikan 9
    }
    jika cocok_kata(src, mulai, akhir, "untuk") {
        kembalikan 10
