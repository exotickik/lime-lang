    jika cocok_kata(src, mulai, akhir, "dari") {
        kembalikan 11
    }
    jika cocok_kata(src, mulai, akhir, "sampai") {
        kembalikan 12
    }
    jika cocok_kata(src, mulai, akhir, "hingga") {
        kembalikan 13
    }
    jika cocok_kata(src, mulai, akhir, "pada") {
        kembalikan 14
    }
    jika cocok_kata(src, mulai, akhir, "berhenti") {
        kembalikan 15
    }
    jika cocok_kata(src, mulai, akhir, "lanjut") {
        kembalikan 16
    }
    jika cocok_kata(src, mulai, akhir, "benar") {
        kembalikan 17
    }
    jika cocok_kata(src, mulai, akhir, "salah") {
        kembalikan 18
    }
    jika cocok_kata(src, mulai, akhir, "tipe") {
        kembalikan 19
    }
    jika cocok_kata(src, mulai, akhir, "enum") {
        kembalikan 20
    }
    jika cocok_kata(src, mulai, akhir, "sifat") {
        kembalikan 21
    }
    jika cocok_kata(src, mulai, akhir, "implementasi") {
        kembalikan 22
    }
    jika cocok_kata(src, mulai, akhir, "cocok") {
        kembalikan 23
    }
    jika cocok_kata(src, mulai, akhir, "coba") {
        kembalikan 24
    }
    jika cocok_kata(src, mulai, akhir, "gunakan") {
        kembalikan 25
    }
    jika cocok_kata(src, mulai, akhir, "impor") {
        kembalikan 26
    }
    jika cocok_kata(src, mulai, akhir, "ekstern") {
        kembalikan 27
    }
    jika cocok_kata(src, mulai, akhir, "publik") {
        kembalikan 28
    }
    jika cocok_kata(src, mulai, akhir, "dan") {
        kembalikan 29
    }
    jika cocok_kata(src, mulai, akhir, "atau") {
        kembalikan 30
    }
    jika cocok_kata(src, mulai, akhir, "bukan") {
        kembalikan 31
    }
    jika cocok_kata(src, mulai, akhir, "sebagai") {
        kembalikan 32
    }
    kembalikan 0 - 1
}

publik fungsi kode_jenis(j: Jenis) -> angka {
    cocok j {
        Pengenal => {
            kembalikan 0
        }
        KataKunci(k) => {
            kembalikan 1
        }
        Bulat(v) => {
            kembalikan 2
        }
        Pecahan => {
            kembalikan 3
        }
        LiteralTeks => {
            kembalikan 4
        }
        Karakter(c) => {
            kembalikan 5
        }
        LParen => {
            kembalikan 6
        }
        RParen => {
            kembalikan 7
        }
        LBrace => {
            kembalikan 8
        }
        RBrace => {
            kembalikan 9
        }
        LBracket => {
            kembalikan 10
        }
        RBracket => {
            kembalikan 11
        }
        Koma => {
            kembalikan 12
        }
        TitikDua => {
            kembalikan 13
        }
        TitikKoma => {
            kembalikan 14
        }
        Titik => {
            kembalikan 15
        }
        Panah => {
            kembalikan 16
        }
        FatPanah => {
            kembalikan 17
        }
        Sama => {
            kembalikan 18
        }
        SamaSama => {
            kembalikan 19
        }
        TakSama => {
            kembalikan 20
        }
        Kurang => {
            kembalikan 21
        }
        KurangSama => {
            kembalikan 22
        }
        Lebih => {
            kembalikan 23
        }
        LebihSama => {
            kembalikan 24
        }
        Tambah => {
            kembalikan 25
        }
        Minus => {
            kembalikan 26
        }
        Bintang => {
            kembalikan 27
        }
        Garis => {
            kembalikan 28
        }
        Persen => {
            kembalikan 29
        }
        AmpAmp => {
            kembalikan 30
        }
        Amp => {
            kembalikan 31
        }
        PipaPipa => {
            kembalikan 32
        }
        Seru => {
            kembalikan 33
        }
        Akhir => {
            kembalikan 34
        }
        TakDikenal => {
            kembalikan 35
        }
    }
    kembalikan 0 - 1
}

publik fungsi kata_kunci_dari(j: Jenis) -> angka {
    cocok j {
        KataKunci(k) => {
            kembalikan k
        }
        lain => {
            kembalikan 0 - 1
        }
    }
    kembalikan 0 - 1
}

publik fungsi nilai_bulat(j: Jenis) -> angka {
    cocok j {
        Bulat(v) => {
            kembalikan v
        }
        lain => {
            kembalikan 0 - 1
        }
    }
    kembalikan 0 - 1
}

publik fungsi nama_kata_kunci(kode: angka) -> teks {
    jika kode == 0 {
        kembalikan "program"
    }
    jika kode == 1 {
        kembalikan "modul"
    }
    jika kode == 2 {
        kembalikan "utama"
    }
    jika kode == 3 {
        kembalikan "fungsi"
    }
    jika kode == 4 {
        kembalikan "kembalikan"
    }
