modul Token

impor Rentang

publik enum Jenis {
    Pengenal,
    KataKunci(angka),
    Bulat(angka),
    Pecahan,
    LiteralTeks,
    Karakter(angka),
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Koma,
    TitikDua,
    TitikKoma,
    Titik,
    Panah,
    FatPanah,
    Sama,
    SamaSama,
    TakSama,
    Kurang,
    KurangSama,
    Lebih,
    LebihSama,
    Tambah,
    Minus,
    Bintang,
    Garis,
    Persen,
    AmpAmp,
    Amp,
    PipaPipa,
    Seru,
    Akhir,
    TakDikenal,
}

publik tipe Token {
    jenis: Jenis
    rentang: Rentang
}

publik fungsi token(jenis: Jenis, mulai: angka, akhir: angka) -> Token {
    kembalikan Token { jenis: jenis, rentang: Rentang { mulai: mulai, akhir: akhir } }
}

publik fungsi cocok_kata(src: &daftar<bita>, mulai: angka, akhir: angka, kw: teks) -> boolean {
    nilai len = akhir - mulai
    jika len != panjang(kw) {
        kembalikan salah
    }
    untuk i dari 0 sampai len {
        jika elemen(src, mulai + i) sebagai angka != bita_pada(kw, i) sebagai angka {
            kembalikan salah
        }
    }
    kembalikan benar
}

publik fungsi kode_kata_kunci(src: &daftar<bita>, mulai: angka, akhir: angka) -> angka {
    jika cocok_kata(src, mulai, akhir, "program") {
        kembalikan 0
    }
    jika cocok_kata(src, mulai, akhir, "modul") {
        kembalikan 1
    }
    jika cocok_kata(src, mulai, akhir, "utama") {
        kembalikan 2
    }
    jika cocok_kata(src, mulai, akhir, "fungsi") {
