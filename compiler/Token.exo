    }
    jika kode == 6 {
        kembalikan "ubah"
    }
    jika kode == 7 {
        kembalikan "jika"
    }
    jika kode == 8 {
        kembalikan "lain"
    }
    jika kode == 9 {
        kembalikan "selama"
    }
    jika kode == 10 {
        kembalikan "untuk"
    }
    jika kode == 11 {
        kembalikan "dari"
    }
    jika kode == 12 {
        kembalikan "sampai"
    }
    jika kode == 13 {
        kembalikan "hingga"
    }
    jika kode == 14 {
        kembalikan "pada"
    }
    jika kode == 15 {
        kembalikan "berhenti"
    }
    jika kode == 16 {
        kembalikan "lanjut"
    }
    jika kode == 17 {
        kembalikan "benar"
    }
    jika kode == 18 {
        kembalikan "salah"
    }
    jika kode == 19 {
        kembalikan "tipe"
    }
    jika kode == 20 {
        kembalikan "enum"
    }
    jika kode == 21 {
        kembalikan "sifat"
    }
    jika kode == 22 {
        kembalikan "implementasi"
    }
    jika kode == 23 {
        kembalikan "cocok"
    }
    jika kode == 24 {
        kembalikan "coba"
    }
    jika kode == 25 {
        kembalikan "gunakan"
    }
    jika kode == 26 {
        kembalikan "impor"
    }
    jika kode == 27 {
        kembalikan "ekstern"
    }
    jika kode == 28 {
        kembalikan "publik"
    }
    jika kode == 29 {
        kembalikan "dan"
    }
    jika kode == 30 {
