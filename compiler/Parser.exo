modul Parser

impor Token

impor Ast

impor Intern

impor Pernyataan

impor Item

publik tipe Langkah {
    idx: angka
    pos: angka
}

fungsi jenis_di(toks: &daftar<Token>, pos: angka) -> Jenis {
    kembalikan elemen(toks, pos).jenis
}

fungsi op_biner(j: Jenis) -> angka {
    nilai k = kode_jenis(j)
    jika k == 25 {
        kembalikan 0
    }
    jika k == 26 {
        kembalikan 1
    }
    jika k == 27 {
        kembalikan 2
    }
    jika k == 28 {
        kembalikan 3
    }
    jika k == 29 {
        kembalikan 4
    }
    jika k == 19 {
        kembalikan 5
    }
    jika k == 20 {
        kembalikan 6
    }
    jika k == 21 {
        kembalikan 7
    }
    jika k == 22 {
        kembalikan 8
    }
    jika k == 23 {
        kembalikan 9
    }
    jika k == 24 {
        kembalikan 10
    }
    jika k == 30 {
        kembalikan 11
    }
    jika k == 32 {
        kembalikan 12
    }
    jika k == 1 {
        nilai kw = kata_kunci_dari(j)
        jika kw == 29 {
            kembalikan 11
        }
        jika kw == 30 {
            kembalikan 12
        }
    }
    kembalikan 0 - 1
}

fungsi prec(op: angka) -> angka {
    jika op == 12 {
        kembalikan 1
    }
    jika op == 11 {
        kembalikan 2
    }
    jika op == 5 || op == 6 {
        kembalikan 3
    }
    jika op >= 7 && op <= 10 {
        kembalikan 4
    }
    jika op == 0 || op == 1 {
        kembalikan 5
    }
    kembalikan 6
}

fungsi tambah(arena: &ubah daftar<Simpul>, s: Simpul) -> angka {
    nilai idx = panjang(arena)
    dorong(arena, s)
    kembalikan idx
}

fungsi set_kanan(arena: &ubah daftar<Simpul>, idx: angka, kanan: angka) {
    nilai s = elemen(arena, idx)
    atur(arena, idx, Simpul { jenis: s.jenis, kiri: s.kiri, kanan: kanan, rentang: s.rentang })
}

fungsi urai_postfix(toks: &daftar<Token>, src: &daftar<bita>, tabel: &ubah Tabel, arena: &ubah daftar<Simpul>, pos: angka) -> Langkah {
    nilai atom = urai_primary(toks, src, tabel, arena, pos)
    ubah idx = atom.idx
    ubah p = atom.pos
    selama kode_jenis(jenis_di(toks, p)) == 6 {
        ubah first_arg = 0 - 1
        ubah prev_arg = 0 - 1
        p = p + 1
        selama kode_jenis(jenis_di(toks, p)) != 7 && kode_jenis(jenis_di(toks, p)) != 34 {
            nilai a = urai_biner(toks, src, tabel, arena, p, 1)
            nilai r = elemen(toks, p).rentang
            nilai argnode = tambah(arena, simpul(JenisSimpul.Arg, a.idx, 0 - 1, r.mulai, r.akhir))
            jika first_arg < 0 {
                first_arg = argnode
            } lain {
                set_kanan(arena, prev_arg, argnode)
            }
            prev_arg = argnode
            p = a.pos
            jika kode_jenis(jenis_di(toks, p)) == 12 {
                p = p + 1
            }
        }
        jika kode_jenis(jenis_di(toks, p)) == 7 {
            p = p + 1
        }
        nilai callee = sym_dari(elemen(arena, idx))
        nilai cr = elemen(arena, idx).rentang
        idx = tambah(arena, simpul(JenisSimpul.Panggil(callee), first_arg, 0 - 1, cr.mulai, cr.akhir))
    }
    kembalikan Langkah { idx: idx, pos: p }
}

fungsi urai_primary(toks: &daftar<Token>, src: &daftar<bita>, tabel: &ubah Tabel, arena: &ubah daftar<Simpul>, pos: angka) -> Langkah {
    nilai j = jenis_di(toks, pos)
    nilai k = kode_jenis(j)
    jika k == 2 {
        nilai v = nilai_bulat(j)
        nilai r = elemen(toks, pos).rentang
        nilai idx = tambah(arena, simpul(JenisSimpul.Bulat(v), 0 - 1, 0 - 1, r.mulai, r.akhir))
        kembalikan Langkah { idx: idx, pos: pos + 1 }
    }
    jika k == 0 {
        nilai r = elemen(toks, pos).rentang
        nilai sym = intern(tabel, src, r.mulai, r.akhir)
        nilai idx = tambah(arena, simpul(JenisSimpul.Pengenal(sym), 0 - 1, 0 - 1, r.mulai, r.akhir))
        kembalikan Langkah { idx: idx, pos: pos + 1 }
    }
    jika k == 6 {
        nilai dalam = urai_biner(toks, src, tabel, arena, pos + 1, 1)
        ubah p = dalam.pos
        jika kode_jenis(jenis_di(toks, p)) == 7 {
            p = p + 1
        }
        kembalikan Langkah { idx: dalam.idx, pos: p }
    }
    nilai r = elemen(toks, pos).rentang
    nilai idx = tambah(arena, simpul(JenisSimpul.Galat, 0 - 1, 0 - 1, r.mulai, r.akhir))
    kembalikan Langkah { idx: idx, pos: pos + 1 }
}

fungsi urai_uner(toks: &daftar<Token>, src: &daftar<bita>, tabel: &ubah Tabel, arena: &ubah daftar<Simpul>, pos: angka) -> Langkah {
    nilai j = jenis_di(toks, pos)
    nilai k = kode_jenis(j)
    jika k == 26 {
        nilai operan = urai_uner(toks, src, tabel, arena, pos + 1)
        nilai r = elemen(toks, pos).rentang
        nilai idx = tambah(arena, simpul(JenisSimpul.Uner(0), operan.idx, 0 - 1, r.mulai, r.akhir))
        kembalikan Langkah { idx: idx, pos: operan.pos }
    }
    jika k == 33 {
        nilai operan = urai_uner(toks, src, tabel, arena, pos + 1)
        nilai r = elemen(toks, pos).rentang
        nilai idx = tambah(arena, simpul(JenisSimpul.Uner(1), operan.idx, 0 - 1, r.mulai, r.akhir))
        kembalikan Langkah { idx: idx, pos: operan.pos }
    }
    jika k == 1 && kata_kunci_dari(j) == 31 {
        nilai operan = urai_uner(toks, src, tabel, arena, pos + 1)
        nilai r = elemen(toks, pos).rentang
        nilai idx = tambah(arena, simpul(JenisSimpul.Uner(1), operan.idx, 0 - 1, r.mulai, r.akhir))
        kembalikan Langkah { idx: idx, pos: operan.pos }
    }
    kembalikan urai_postfix(toks, src, tabel, arena, pos)
}

fungsi urai_biner(toks: &daftar<Token>, src: &daftar<bita>, tabel: &ubah Tabel, arena: &ubah daftar<Simpul>, pos: angka, min_prec: angka) -> Langkah {
    nilai kiri = urai_uner(toks, src, tabel, arena, pos)
    ubah idx = kiri.idx
    ubah p = kiri.pos
    selama benar {
        nilai op = op_biner(jenis_di(toks, p))
        jika op < 0 {
            berhenti
        }
        nilai pr = prec(op)
        jika pr < min_prec {
            berhenti
        }
        nilai kanan = urai_biner(toks, src, tabel, arena, p + 1, pr + 1)
        nilai r = elemen(toks, p).rentang
        idx = tambah(arena, simpul(JenisSimpul.Biner(op), idx, kanan.idx, r.mulai, r.akhir))
        p = kanan.pos
    }
    kembalikan Langkah { idx: idx, pos: p }
}

publik fungsi urai_ekspresi(toks: &daftar<Token>, src: &daftar<bita>, tabel: &ubah Tabel, arena: &ubah daftar<Simpul>) -> angka {
    nilai hasil = urai_biner(toks, src, tabel, arena, 0, 1)
    kembalikan hasil.idx
}

fungsi tambah_p(sarena: &ubah daftar<Pernyataan>, p: Pernyataan) -> angka {
    nilai idx = panjang(sarena)
    dorong(sarena, p)
    kembalikan idx
}

fungsi set_next(sarena: &ubah daftar<Pernyataan>, idx: angka, next: angka) {
    nilai p = elemen(sarena, idx)
    atur(sarena, idx, Pernyataan { jenis: p.jenis, ekspr: p.ekspr, blok1: p.blok1, blok2: p.blok2, next: next })
}

fungsi urai_blok(toks: &daftar<Token>, src: &daftar<bita>, tabel: &ubah Tabel, earena: &ubah daftar<Simpul>, sarena: &ubah daftar<Pernyataan>, pos: angka) -> Langkah {
    ubah p = pos
    jika kode_jenis(jenis_di(toks, p)) == 8 {
        p = p + 1
    }
    nilai seq = urai_seq(toks, src, tabel, earena, sarena, p, 9)
    ubah q = seq.pos
    jika kode_jenis(jenis_di(toks, q)) == 9 {
        q = q + 1
    }
    kembalikan Langkah { idx: seq.idx, pos: q }
}

fungsi urai_seq(toks: &daftar<Token>, src: &daftar<bita>, tabel: &ubah Tabel, earena: &ubah daftar<Simpul>, sarena: &ubah daftar<Pernyataan>, pos: angka, term: angka) -> Langkah {
    ubah first = 0 - 1
    ubah prev = 0 - 1
    ubah p = pos
    selama kode_jenis(jenis_di(toks, p)) != term && kode_jenis(jenis_di(toks, p)) != 34 {
        nilai st = urai_pernyataan(toks, src, tabel, earena, sarena, p)
        jika st.pos <= p {
            berhenti
        }
        jika first < 0 {
            first = st.idx
        } lain {
            set_next(sarena, prev, st.idx)
        }
        prev = st.idx
        p = st.pos
    }
    kembalikan Langkah { idx: first, pos: p }
}

fungsi urai_pernyataan(toks: &daftar<Token>, src: &daftar<bita>, tabel: &ubah Tabel, earena: &ubah daftar<Simpul>, sarena: &ubah daftar<Pernyataan>, pos: angka) -> Langkah {
    nilai j = jenis_di(toks, pos)
    nilai k = kode_jenis(j)
    jika k == 1 {
        nilai kw = kata_kunci_dari(j)
        jika kw == 5 || kw == 6 {
            nilai r = elemen(toks, pos + 1).rentang
            nilai sym = intern(tabel, src, r.mulai, r.akhir)
            nilai e = urai_biner(toks, src, tabel, earena, pos + 3, 1)
            ubah idx = 0
            jika kw == 5 {
                idx = tambah_p(sarena, pernyataan(JenisPernyataan.Nilai(sym), e.idx))
            } lain {
                idx = tambah_p(sarena, pernyataan(JenisPernyataan.Ubah(sym), e.idx))
            }
            kembalikan Langkah { idx: idx, pos: e.pos }
        }
        jika kw == 4 {
            nilai e = urai_biner(toks, src, tabel, earena, pos + 1, 1)
            nilai idx = tambah_p(sarena, pernyataan(JenisPernyataan.Kembali, e.idx))
            kembalikan Langkah { idx: idx, pos: e.pos }
        }
        jika kw == 7 {
            nilai c = urai_biner(toks, src, tabel, earena, pos + 1, 1)
            nilai b1 = urai_blok(toks, src, tabel, earena, sarena, c.pos)
            ubah b2 = 0 - 1
            ubah akhir = b1.pos
            jika kode_jenis(jenis_di(toks, b1.pos)) == 1 && kata_kunci_dari(jenis_di(toks, b1.pos)) == 8 {
                nilai setelah = b1.pos + 1
                jika kode_jenis(jenis_di(toks, setelah)) == 1 && kata_kunci_dari(jenis_di(toks, setelah)) == 7 {
                    nilai lain_if = urai_pernyataan(toks, src, tabel, earena, sarena, setelah)
                    b2 = lain_if.idx
                    akhir = lain_if.pos
                } lain {
                    nilai b2blk = urai_blok(toks, src, tabel, earena, sarena, setelah)
                    b2 = b2blk.idx
                    akhir = b2blk.pos
                }
            }
            nilai idx = tambah_p(sarena, kendali(JenisPernyataan.Jika, c.idx, b1.idx, b2))
            kembalikan Langkah { idx: idx, pos: akhir }
        }
        jika kw == 9 {
            nilai c = urai_biner(toks, src, tabel, earena, pos + 1, 1)
            nilai b1 = urai_blok(toks, src, tabel, earena, sarena, c.pos)
            nilai idx = tambah_p(sarena, kendali(JenisPernyataan.Selama, c.idx, b1.idx, 0 - 1))
            kembalikan Langkah { idx: idx, pos: b1.pos }
        }
    }
    jika k == 0 && kode_jenis(jenis_di(toks, pos + 1)) == 18 {
        nilai r = elemen(toks, pos).rentang
        nilai sym = intern(tabel, src, r.mulai, r.akhir)
        nilai e = urai_biner(toks, src, tabel, earena, pos + 2, 1)
        nilai idx = tambah_p(sarena, pernyataan(JenisPernyataan.Tetapkan(sym), e.idx))
        kembalikan Langkah { idx: idx, pos: e.pos }
    }
    nilai e = urai_biner(toks, src, tabel, earena, pos, 1)
    nilai idx = tambah_p(sarena, pernyataan(JenisPernyataan.Ekspr, e.idx))
    kembalikan Langkah { idx: idx, pos: e.pos }
}

publik fungsi urai_program(toks: &daftar<Token>, src: &daftar<bita>, tabel: &ubah Tabel, earena: &ubah daftar<Simpul>, sarena: &ubah daftar<Pernyataan>) -> angka {
    nilai seq = urai_seq(toks, src, tabel, earena, sarena, 0, 34)
    kembalikan seq.idx
}

fungsi lewati_seimbang(toks: &daftar<Token>, pos: angka, buka: angka, tutup: angka) -> angka {
    ubah p = pos
    ubah dalam = 0
    selama kode_jenis(jenis_di(toks, p)) != 34 {
        nilai kk = kode_jenis(jenis_di(toks, p))
        jika kk == buka {
            dalam = dalam + 1
        }
        jika kk == tutup {
            dalam = dalam - 1
        }
        p = p + 1
        jika dalam == 0 {
            berhenti
        }
    }
    kembalikan p
}

fungsi urai_tipe(toks: &daftar<Token>, pos: angka) -> angka {
    ubah p = pos
    jika kode_jenis(jenis_di(toks, p)) == 31 {
        p = p + 1
    }
    jika kode_jenis(jenis_di(toks, p)) == 1 && kata_kunci_dari(jenis_di(toks, p)) == 6 {
        p = p + 1
    }
    jika kode_jenis(jenis_di(toks, p)) == 10 {
        kembalikan lewati_seimbang(toks, p, 10, 11)
    }
    jika kode_jenis(jenis_di(toks, p)) == 0 {
        p = p + 1
    }
    jika kode_jenis(jenis_di(toks, p)) == 21 {
        p = lewati_seimbang(toks, p, 21, 23)
    }
    kembalikan p
}

fungsi urai_fungsi(toks: &daftar<Token>, src: &daftar<bita>, tabel: &ubah Tabel, earena: &ubah daftar<Simpul>, sarena: &ubah daftar<Pernyataan>, parms: &ubah daftar<angka>, funcs: &ubah daftar<Fungsi>, pos: angka) -> angka {
    ubah p = pos
    jika kode_jenis(jenis_di(toks, p)) == 1 && kata_kunci_dari(jenis_di(toks, p)) == 28 {
        p = p + 1
    }
    p = p + 1
    nilai nr = elemen(toks, p).rentang
    nilai nama = intern(tabel, src, nr.mulai, nr.akhir)
    p = p + 1
    jika kode_jenis(jenis_di(toks, p)) == 21 {
        p = lewati_seimbang(toks, p, 21, 23)
    }
    jika kode_jenis(jenis_di(toks, p)) == 6 {
        p = p + 1
    }
    nilai param_mulai = panjang(parms)
    ubah param_jumlah = 0
    selama kode_jenis(jenis_di(toks, p)) != 7 && kode_jenis(jenis_di(toks, p)) != 34 {
        nilai pr = elemen(toks, p).rentang
        nilai psym = intern(tabel, src, pr.mulai, pr.akhir)
        dorong(parms, psym)
        param_jumlah = param_jumlah + 1
        p = p + 1
        jika kode_jenis(jenis_di(toks, p)) == 13 {
            p = p + 1
            p = urai_tipe(toks, p)
        }
        jika kode_jenis(jenis_di(toks, p)) == 12 {
            p = p + 1
        }
    }
    jika kode_jenis(jenis_di(toks, p)) == 7 {
        p = p + 1
    }
    jika kode_jenis(jenis_di(toks, p)) == 16 {
        p = p + 1
        p = urai_tipe(toks, p)
    }
    nilai b = urai_blok(toks, src, tabel, earena, sarena, p)
    dorong(funcs, fungsi_baru(nama, param_mulai, param_jumlah, b.idx))
    kembalikan b.pos
}

publik fungsi urai_item_program(toks: &daftar<Token>, src: &daftar<bita>, tabel: &ubah Tabel, earena: &ubah daftar<Simpul>, sarena: &ubah daftar<Pernyataan>, parms: &ubah daftar<angka>, funcs: &ubah daftar<Fungsi>) {
    ubah pos = 0
    selama kode_jenis(jenis_di(toks, pos)) != 34 {
        nilai j = jenis_di(toks, pos)
        jika kode_jenis(j) != 1 {
            berhenti
        }
        nilai kw = kata_kunci_dari(j)
        jika kw != 3 && kw != 28 {
            berhenti
        }
        nilai maju = urai_fungsi(toks, src, tabel, earena, sarena, parms, funcs, pos)
        jika maju <= pos {
            berhenti
        }
        pos = maju
    }
}
