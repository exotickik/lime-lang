modul Turunkan

impor Ast

impor Pernyataan

impor Item

impor Ir

tipe Slot {
    nama: angka
    reg: angka
}

tipe KonteksTurun {
    slot: daftar<Slot>
    tinggi: angka
}

fungsi konteks_turun_baru() -> KonteksTurun {
    kembalikan KonteksTurun { slot: daftar(), tinggi: 0 }
}

fungsi tambah_slot(kt: &ubah KonteksTurun, nama: angka, reg: angka) {
    nilai entri = Slot { nama: nama, reg: reg }
    nilai len_s = panjang(ambil(kt.slot))
    nilai idx = kt.tinggi
    jika idx < len_s {
        atur(ambil_ubah(kt.slot), idx, entri)
    } jika tidak {
        masukkan(ambil_ubah(kt.slot), entri)
    }
    kt.tinggi = idx + 1
}

fungsi cari_slot(kt: &KonteksTurun, nama: angka) -> angka {
    ubah i = kt.tinggi - 1
    selama i >= 0 {
        nilai s = elemen(ambil(kt.slot), i)
        jika s.nama == nama {
            kembalikan s.reg
        }
        i = i - 1
    }
    kembalikan 0 - 1
}

fungsi turunkan_ekspr(ir: &ubah ProgramIr, kt: &ubah KonteksTurun, earena: &daftar<Simpul>, idx: angka) -> angka {
    jika idx < 0 {
        nilai r = reg_baru(ir)
        tambah_inst(ir, JenisIr.Konst(0), r, 0, 0)
        kembalikan r
    }
    nilai s = elemen(earena, idx)
    nilai kd = kode_simpul(s)
    jika kd == 0 {
        nilai r = reg_baru(ir)
        tambah_inst(ir, JenisIr.Konst(nilai_bulat_dari(s)), r, 0, 0)
        kembalikan r
    }
    jika kd == 4 {
        nilai slot_reg = cari_slot(kt, sym_dari(s))
        nilai r = reg_baru(ir)
        tambah_inst(ir, JenisIr.Muat, r, slot_reg, 0)
        kembalikan r
    }
    jika kd == 1 {
        nilai v = turunkan_ekspr(ir, kt, earena, s.kiri)
        nilai r = reg_baru(ir)
        tambah_inst(ir, JenisIr.Uner(op_uner_dari(s)), r, v, 0)
        kembalikan r
    }
    jika kd == 2 {
        nilai va = turunkan_ekspr(ir, kt, earena, s.kiri)
        nilai vb = turunkan_ekspr(ir, kt, earena, s.kanan)
        nilai r = reg_baru(ir)
        tambah_inst(ir, JenisIr.Biner(op_biner_dari(s)), r, va, vb)
        kembalikan r
    }
    jika kd == 5 {
        ubah regs: daftar<angka> = daftar()
        ubah a = s.kiri
        selama a >= 0 {
            nilai an = elemen(earena, a)
            nilai rv = turunkan_ekspr(ir, kt, earena, an.kiri)
            masukkan(ambil_ubah(regs), rv)
            a = an.kanan
        }
        nilai mulai = panjang(ambil(ir.arg))
        nilai jumlah = panjang(ambil(regs))
        untuk i dari 0 sampai jumlah {
            masukkan(ambil_ubah(ir.arg), elemen(ambil(regs), i))
        }
        nilai r = reg_baru(ir)
        tambah_inst(ir, JenisIr.Panggil(callee_dari(s)), r, mulai, jumlah)
        kembalikan r
    }
    nilai r = reg_baru(ir)
    tambah_inst(ir, JenisIr.Konst(0), r, 0, 0)
    kembalikan r
}

fungsi turunkan_blok(ir: &ubah ProgramIr, kt: &ubah KonteksTurun, earena: &daftar<Simpul>, sarena: &daftar<Pernyataan>, head: angka) {
    nilai saved = kt.tinggi
    ubah cur = head
    selama cur >= 0 {
        nilai p = elemen(sarena, cur)
        nilai kd = kode_pernyataan(p)
        jika kd == 0 || kd == 1 {
            nilai v = turunkan_ekspr(ir, kt, earena, p.ekspr)
            nilai slot = reg_baru(ir)
            tambah_inst(ir, JenisIr.Alok, slot, 0, 0)
            tambah_inst(ir, JenisIr.Simpan, 0, v, slot)
            tambah_slot(kt, sym_pernyataan(p), slot)
        } atau jika kd == 2 {
            nilai v = turunkan_ekspr(ir, kt, earena, p.ekspr)
            nilai slot = cari_slot(kt, sym_pernyataan(p))
            tambah_inst(ir, JenisIr.Simpan, 0, v, slot)
        } atau jika kd == 3 {
            nilai v = turunkan_ekspr(ir, kt, earena, p.ekspr)
            tambah_inst(ir, JenisIr.Kembalikan, 0, v, 0)
        } atau jika kd == 4 {
            turunkan_ekspr(ir, kt, earena, p.ekspr)
        } atau jika kd == 5 {
            nilai c = turunkan_ekspr(ir, kt, earena, p.ekspr)
            nilai lt = label_baru(ir)
            nilai lf = label_baru(ir)
            nilai le = label_baru(ir)
            tambah_inst(ir, JenisIr.Cabang(lt), 0, c, lf)
            tambah_inst(ir, JenisIr.Label(lt), 0, 0, 0)
            turunkan_blok(ir, kt, earena, sarena, p.blok1)
            tambah_inst(ir, JenisIr.Lompat(le), 0, 0, 0)
            tambah_inst(ir, JenisIr.Label(lf), 0, 0, 0)
            jika p.blok2 >= 0 {
                turunkan_blok(ir, kt, earena, sarena, p.blok2)
            }
            tambah_inst(ir, JenisIr.Lompat(le), 0, 0, 0)
            tambah_inst(ir, JenisIr.Label(le), 0, 0, 0)
        } atau jika kd == 6 {
            nilai lc = label_baru(ir)
            nilai lb = label_baru(ir)
            nilai le = label_baru(ir)
            tambah_inst(ir, JenisIr.Lompat(lc), 0, 0, 0)
            tambah_inst(ir, JenisIr.Label(lc), 0, 0, 0)
            nilai c = turunkan_ekspr(ir, kt, earena, p.ekspr)
            tambah_inst(ir, JenisIr.Cabang(lb), 0, c, le)
            tambah_inst(ir, JenisIr.Label(lb), 0, 0, 0)
            turunkan_blok(ir, kt, earena, sarena, p.blok1)
            tambah_inst(ir, JenisIr.Lompat(lc), 0, 0, 0)
            tambah_inst(ir, JenisIr.Label(le), 0, 0, 0)
        }
        cur = p.next
    }
    kt.tinggi = saved
}

publik fungsi turunkan_program(earena: &daftar<Simpul>, sarena: &daftar<Pernyataan>, funcs: &daftar<Fungsi>, parms: &daftar<angka>) -> ProgramIr {
    ubah ir = program_ir_baru()
    untuk i dari 0 sampai panjang(funcs) {
        nilai f = elemen(funcs, i)
        ubah kt = konteks_turun_baru()
        ir.next_reg = f.param_jumlah
        nilai inst_mulai = panjang(ambil(ir.inst))
        untuk j dari 0 sampai f.param_jumlah {
            nilai slot = reg_baru(ambil_ubah(ir))
            tambah_inst(ambil_ubah(ir), JenisIr.Alok, slot, 0, 0)
            tambah_inst(ambil_ubah(ir), JenisIr.Simpan, 0, j, slot)
            tambah_slot(ambil_ubah(kt), elemen(parms, f.param_mulai + j), slot)
        }
        turunkan_blok(ambil_ubah(ir), ambil_ubah(kt), earena, sarena, f.body)
        nilai r0 = reg_baru(ambil_ubah(ir))
        tambah_inst(ambil_ubah(ir), JenisIr.Konst(0), r0, 0, 0)
        tambah_inst(ambil_ubah(ir), JenisIr.Kembalikan, 0, r0, 0)
        nilai inst_akhir = panjang(ambil(ir.inst))
        masukkan(ambil_ubah(ir.daftar_fungsi), IrFungsi { nama: f.nama, param_mulai: f.param_mulai, param_jumlah: f.param_jumlah, inst_mulai: inst_mulai, inst_akhir: inst_akhir })
    }
    kembalikan ir
}
