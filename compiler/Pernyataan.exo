modul Pernyataan

publik enum JenisPernyataan {
    Nilai(angka),
    Ubah(angka),
    Tetapkan(angka),
    Kembali,
    Ekspr,
    Jika,
    Selama,
}

publik tipe Pernyataan {
    jenis: JenisPernyataan
    ekspr: angka
    blok1: angka
    blok2: angka
    next: angka
}

publik fungsi pernyataan(jenis: JenisPernyataan, ekspr: angka) -> Pernyataan {
    kembalikan Pernyataan { jenis: jenis, ekspr: ekspr, blok1: 0 - 1, blok2: 0 - 1, next: 0 - 1 }
}

publik fungsi kendali(jenis: JenisPernyataan, ekspr: angka, blok1: angka, blok2: angka) -> Pernyataan {
    kembalikan Pernyataan { jenis: jenis, ekspr: ekspr, blok1: blok1, blok2: blok2, next: 0 - 1 }
}

publik fungsi kode_pernyataan(p: Pernyataan) -> angka {
    cocok p.jenis {
        Nilai(s) => {
            kembalikan 0
        }
        Ubah(s) => {
            kembalikan 1
        }
        Tetapkan(s) => {
            kembalikan 2
        }
        Kembali => {
            kembalikan 3
        }
        Ekspr => {
            kembalikan 4
        }
        Jika => {
            kembalikan 5
        }
        Selama => {
            kembalikan 6
        }
    }
    kembalikan 0 - 1
}

publik fungsi sym_pernyataan(p: Pernyataan) -> angka {
    cocok p.jenis {
        Nilai(s) => {
            kembalikan s
        }
        Ubah(s) => {
            kembalikan s
        }
        Tetapkan(s) => {
            kembalikan s
        }
        lain => {
            kembalikan 0 - 1
        }
    }
    kembalikan 0 - 1
}
